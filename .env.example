# PROJECT TITAN — local configuration template (TITAN-BCK-026: all config via env).
# Copy to .env before `docker compose up`. Values below are safe local defaults.

# --- PostgreSQL (system of record, ADR-004) ---
POSTGRES_USER=titan
POSTGRES_PASSWORD=titan
POSTGRES_DB=titan

# --- Backend (titan.settings, TITAN_ prefix) ---
TITAN_LOG_LEVEL=INFO
# Host-side runs (make migrate, uv run uvicorn) reach services on localhost;
# inside Compose the api container gets container-hostname URLs from
# docker-compose.yml and these are ignored there.
TITAN_DATABASE_URL=postgresql+asyncpg://titan:titan@localhost:5432/titan
TITAN_REDIS_URL=redis://localhost:6379/0
TITAN_QDRANT_URL=http://localhost:6333

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM gateway (Phase 15; Vol 7 §8.2, ADR-007) ---
# Routing/aliases/providers live in config/models.yaml (hot-reloadable). Point
# this at config/models.local.yaml for the fully-local, zero-paid-key profile.
# TITAN_MODELS_CONFIG_PATH=/app/config/models.yaml
# Ollama base URL (container hostname in Compose; localhost for host runs).
# TITAN_OLLAMA_BASE_URL=http://ollama:11434
# Paid providers — leave BLANK for the zero-key local profile. Referenced by
# ${ENV_VAR} from models.yaml; a missing key only fails if that provider is used.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# Start Ollama with:  docker compose --profile local-llm up -d ollama
# then pull models:   docker exec titan-ollama-1 ollama pull nomic-embed-text

# Host port for the web UI (spec default 3000; uncomment on port conflict)
# WEB_PORT=3002   (3001 is Grafana once the Phase-4 observability profile lands)
# POSTGRES_PORT=25432
# REDIS_PORT=26379

# --- Observability (Phase 4; opt-in: docker compose --profile observability up) ---
# Set the OTLP endpoint so the api exports traces when the obs profile runs:
# TITAN_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_PASSWORD=titan-local
# PROMETHEUS_PORT=29090
# OTEL_PORT=24317
# LOKI_PORT=23100

# NOTE: leave TITAN_OTEL_EXPORTER_OTLP_ENDPOINT unset when running WITHOUT the
# observability profile — a set endpoint with no collector produces periodic
# "Failed to export traces" errors in the api logs (harmless but noisy).
# Disposable DB for pytest -m schema (contents are wiped every run!)
# TITAN_TEST_DATABASE_URL=postgresql+asyncpg://titan:titan@localhost:5432/titan_test

# --- Sandbox & container tools (Phases 20–22; Vol 7 §4.3, Vol 8 §5) ---
# All have working defaults; override only for non-standard hosts. The code-exec
# sandbox, the docker.* rootless DinD sidecar, and the browser.* Chromium
# container all talk to the host Docker daemon via the SDK's default endpoint —
# so they are TOOL_UNAVAILABLE in the socket-less api/worker containers by design
# and run on a Docker-reachable host / sandbox node.
# TITAN_SANDBOX_IMAGE=titan-sandbox:local
# TITAN_SANDBOX_WORKSPACE_ROOT=/var/lib/titan/workspaces
# TITAN_SANDBOX_DOCKER_HOST=            # empty = SDK default (unix socket / npipe)
# TITAN_DIND_IMAGE=docker:dind-rootless
# TITAN_DIND_PRELOADED_IMAGES=titan-sandbox:local   # comma-separated or JSON list
# TITAN_BROWSER_IMAGE=titan-browser:local
# Build the tooled images once:
#   docker build -f infra/docker/titan-sandbox.Dockerfile -t titan-sandbox:local .
#   docker build -f infra/docker/titan-browser.Dockerfile -t titan-browser:local .

# --- Identity (Phase 8) ---
# Stable RS256 signing key (base64 PEM). Generate:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization; import base64; k=rsa.generate_private_key(public_exponent=65537,key_size=2048); print(base64.b64encode(k.private_bytes(serialization.Encoding.PEM,serialization.PrivateFormat.PKCS8,serialization.NoEncryption())).decode())"
# Empty = ephemeral dev keypair (tokens die on restart).
# TITAN_JWT_PRIVATE_KEY_B64=
# TITAN_BOOTSTRAP_ADMIN_PASSWORD=titan-local-admin   (make seed; local only)
