# Generated by `titan-ci-init --scaffold` (Phase 46). The Phase-45 kit ships
# ruff.toml / .importlinter separately; this file carries the project's deps,
# pytest markers, and the coverage `source` setting the diff-coverage gate needs.

[project]
name = "__PKG__"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.110",
    "structlog>=24.1",
]

[project.optional-dependencies]
test = [
    "pytest>=8.2",
    "pytest-cov>=5.0",
    "httpx>=0.27",           # FastAPI TestClient
    "testcontainers>=4.0",   # real PG16/Redis7 integration layer
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/__PKG__"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
    "e2e: Playwright end-to-end journeys (needs a running app + browsers)",
    "integration: needs Docker for testcontainers (PG16/Redis7)",
]

[tool.coverage.run]
branch = true
# Naming the source makes coverage.py report an unexecuted new module at 0%
# rather than omitting it — defence in depth for the diff-coverage gate.
source = ["src/__PKG__"]
relative_files = true
