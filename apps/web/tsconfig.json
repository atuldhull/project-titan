{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@titan/schemas": [
        "../../packages/schemas/src/index.ts"
      ],
      "@titan/schemas/*": [
        "../../packages/schemas/src/*"
      ],
      "@titan/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@titan/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@titan/ws-protocol": [
        "../../packages/ws-protocol/src/index.ts"
      ],
      "@titan/ws-protocol/*": [
        "../../packages/ws-protocol/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lint-fixtures"
  ]
}
