{
  "name": "@titan/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the TITAN OpenAPI spec (ADR-001; generation pipeline arrives in Phase 3)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript openapi.json -o src/api.ts",
    "lint:openapi": "spectral lint openapi.json --ruleset ../../.spectral.yaml --fail-severity error"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
